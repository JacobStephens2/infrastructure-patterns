---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="evidence-note wrap">
    <p class="eyebrow">404 / Page not found</p>
    <h1>This record isn't here.</h1>
    <p>
      The address may be old, or the record may have been withdrawn. Decision
      numbers are never reused; withdrawn records remain in the repository's
      history.
    </p>
    <a class="button" href="/#library">
      Browse the current collection →
    </a>
  </section>
</Base>
